{"schemaVersion": 39, "uid": "demo-services", "title": "Demo Services", "refresh": "10s", "time": {"from": "now-30m", "to": "now"}, "templating": {"list": [{"name": "svc", "type": "query", "datasource": {"type": "prometheus", "uid": "prom"}, "query": "label_values(http_server_request_duration_seconds_count, service_name)", "includeAll": true, "multi": true, "refresh": 1}]}, "panels": [{"id": 1, "title": "p95 latency", "type": "timeseries", "datasource": {"type": "prometheus", "uid": "prom"}, "gridPos": {"x": 0, "y": 0, "w": 24, "h": 8}, "fieldConfig": {"defaults": {"unit": "s"}}, "targets": [{"expr": "histogram_quantile(0.95, sum by (le, service_name) (rate(http_server_request_duration_seconds_bucket{service_name=~\"$svc\"}[5m])))", "legend": "{{service_name}}"}]}, {"id": 2, "title": "Error rate %", "type": "timeseries", "datasource": {"type": "prometheus", "uid": "prom"}, "gridPos": {"x": 0, "y": 8, "w": 24, "h": 8}, "fieldConfig": {"defaults": {"unit": "percent"}}, "targets": [{"expr": "100 * sum by (service_name) (rate(http_server_request_duration_seconds_count{service_name=~\"$svc\",http_response_status_code=~\"5..\"}[5m])) / sum by (service_name) (rate(http_server_request_duration_seconds_count{service_name=~\"$svc\"}[5m]))", "legend": "{{service_name}}"}]}, {"id": 3, "title": "Requests/s", "type": "timeseries", "datasource": {"type": "prometheus", "uid": "prom"}, "gridPos": {"x": 0, "y": 16, "w": 24, "h": 8}, "fieldConfig": {"defaults": {"unit": "reqps"}}, "targets": [{"expr": "sum by (service_name) (rate(http_server_request_duration_seconds_count{service_name=~\"$svc\"}[1m]))", "legend": "{{service_name}}"}]}]}